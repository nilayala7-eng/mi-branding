# ─────────────────────────────────────────────────────────────────────────────
# Ayala OS — environment variables
# Copy to .env.local (never commit .env.local). All values are server-only
# unless prefixed NEXT_PUBLIC_. See SETUP.md for how to obtain each one.
# ─────────────────────────────────────────────────────────────────────────────

# Data source: "mock" (Phase 1 demo data) or "supabase" (Phase 2, not ready yet)
DATA_SOURCE=mock
APP_URL=http://localhost:3000
ACCOUNT_TIMEZONE=Europe/Madrid

# Access control — REQUIRED in production (the app refuses to serve without it).
# Browser will ask for it (any username, this password).
APP_ACCESS_PASSWORD=

# 32+ random characters. Encrypts Instagram tokens at rest and signs OAuth state.
# Generate with:  openssl rand -base64 48
APP_ENCRYPTION_KEY=

# ── Claude (CLAUDE_SETUP.md) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Supabase (Phase 2) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS: server-only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta / Instagram (Phase 2 — META_SETUP.md) ──────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Set to the current Graph API version shown in the Meta App Dashboard.
META_GRAPH_API_VERSION=v24.0
