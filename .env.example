# ─────────────────────────────────────────────────────────────────────────────
# Ayala OS — environment variables
# Copy to .env.local (never commit .env.local). All values are server-only
# unless prefixed NEXT_PUBLIC_. See SETUP.md for how to obtain each one.
# ─────────────────────────────────────────────────────────────────────────────

# Data source: "mock" (demo data) or "supabase" (real data from Postgres)
DATA_SOURCE=mock
APP_URL=http://localhost:3000
ACCOUNT_TIMEZONE=Europe/Madrid

# Access control — REQUIRED in production (the app refuses to serve without it).
# Browser will ask for it (any username, this password).
APP_ACCESS_PASSWORD=

# 32+ random characters. Encrypts Instagram tokens at rest and signs OAuth state.
# Generate with:  openssl rand -base64 48
APP_ENCRYPTION_KEY=

# ── Claude (CLAUDE_SETUP.md) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Supabase / Postgres ─────────────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" connection string (port 6543).
# Contains the DB password: server-only, never expose it.
DATABASE_URL=

# ── Meta / Instagram (META_SETUP.md) ────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Current version per Meta docs (2026-09). Update when Meta releases a new one.
META_GRAPH_API_VERSION=v26.0

# Secret for the daily sync cron (Vercel sends it automatically). openssl rand -hex 32
CRON_SECRET=
